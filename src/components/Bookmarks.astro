---
// Bookmarks component.
//
// The markup below renders during the static build. All dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro runs that script in the browser, never during the build, so
// browser-only APIs (like localStorage) are safe there and never touch the
// static build.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
    <p id="url-error" class="error" role="alert" hidden></p>
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only. The pure helpers
  // (normalising URLs, validating storage, formatting, slug generation)
  // live in ../lib/bookmarks.js so they can be unit-tested outside a
  // browser; this script only wires them up to the DOM and localStorage.
  import {
    STORAGE_KEY,
    normalizeUrl,
    loadBookmarks,
    updateBookmarkUrl,
    formatBookmark,
    createSlug,
  } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const urlError = document.getElementById('url-error');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');
  const list = document.getElementById('bookmark-list');

  // Treat localStorage itself as untrusted/unavailable (private browsing,
  // disabled storage, quota errors, etc.) — never let a storage failure
  // throw out of these helpers.
  function readStoredBookmarks() {
    try {
      return loadBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeStoredBookmarks(bookmarks: Array<{ url: string; slug: string }>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    } catch {
      // Ignore quota/privacy-mode errors — the in-memory render still works
      // for the current page view even if persistence fails.
    }
  }

  function showError(message: string) {
    if (!urlError) return;
    urlError.textContent = message;
    urlError.hidden = false;
  }

  function clearError() {
    if (!urlError) return;
    urlError.textContent = '';
    urlError.hidden = true;
  }

  function focusEditButton(slug: string) {
    list
      ?.querySelector<HTMLButtonElement>(`.edit[data-slug="${slug}"]`)
      ?.focus();
  }

  function render(bookmarks: Array<{ url: string; slug: string }>) {
    if (!list || !emptyState || !listHeader) return;

    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';
      li.title = formatBookmark(bookmark);

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      // The exact visible separator between the URL and its slug.
      const separator = document.createTextNode(' :: ');

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.ariaLabel = `Copy slug ${bookmark.slug}`;
      copyButton.addEventListener('click', () => {
        navigator.clipboard?.writeText(bookmark.slug).catch(() => {
          // Clipboard access can be denied/unavailable — nothing to recover.
        });
      });

      const editButton = document.createElement('button');
      editButton.type = 'button';
      editButton.className = 'edit';
      editButton.textContent = 'Edit';
      editButton.ariaLabel = `Edit ${bookmark.url}`;
      editButton.dataset.slug = bookmark.slug;
      editButton.addEventListener('click', () => {
        const editForm = document.createElement('form');
        editForm.className = 'edit-form';

        const field = document.createElement('div');
        field.className = 'field';

        const label = document.createElement('label');
        const inputId = `edit-${bookmark.slug}`;
        label.htmlFor = inputId;
        label.textContent = `Edit link for ${bookmark.slug}`;

        const input = document.createElement('input');
        input.id = inputId;
        input.type = 'text';
        input.inputMode = 'url';
        input.value = bookmark.url;
        input.required = true;

        const error = document.createElement('p');
        error.className = 'error';
        error.role = 'alert';

        const saveButton = document.createElement('button');
        saveButton.type = 'submit';
        saveButton.textContent = 'Save';

        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.className = 'cancel';
        cancelButton.textContent = 'Cancel';
        cancelButton.addEventListener('click', () => {
          render(bookmarks);
          focusEditButton(bookmark.slug);
        });

        editForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const updated = updateBookmarkUrl(bookmarks, bookmark.slug, input.value);
          if (!updated) {
            error.textContent = 'Enter a valid URL, e.g. example.com or https://example.com.';
            return;
          }

          writeStoredBookmarks(updated);
          render(updated);
          focusEditButton(bookmark.slug);
        });

        field.append(label, input, error);
        editForm.append(field, saveButton, cancelButton);
        li.replaceChildren(editForm);
        input.focus();
        input.select();
      });

      li.append(link, separator, slug, copyButton, editButton);
      list.appendChild(li);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this first — stops the page from reloading
    try {
      clearError();
      const rawValue = urlInput?.value ?? '';
      const normalized = normalizeUrl(rawValue);

      if (!normalized) {
        showError('Enter a valid URL, e.g. example.com or https://example.com.');
        return;
      }

      const current = readStoredBookmarks();
      const slug = createSlug(current.map((bookmark) => bookmark.slug));
      const updated = [...current, { url: normalized, slug }];

      writeStoredBookmarks(updated);
      render(updated);
      form.reset();
      urlInput?.focus();
    } catch {
      // Never let an unexpected error surface as a native form submit —
      // preventDefault() above already stopped the reload/navigation.
      showError('Something went wrong adding that bookmark. Please try again.');
    }
  });

  clearAllButton?.addEventListener('click', () => {
    try {
      const confirmed = window.confirm('Remove all saved bookmarks?');
      if (!confirmed) return;
      writeStoredBookmarks([]);
      render([]);
    } catch {
      // Ignore — nothing more we can safely do here.
    }
  });

  // On page load, read the saved bookmarks so the list persists across reloads.
  render(readStoredBookmarks());
</script>
